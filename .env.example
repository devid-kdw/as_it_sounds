# AIS public browser-safe variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# AIS access and billing modes
AIS_ACCESS_MODE=local_owner
AIS_BILLING_MODE=disabled
AIS_OWNER_EMAIL=owner@example.com

# Supabase server-only secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Stripe server-only secrets, required only when billing mode is test or live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Audio worker server-only configuration
AUDIO_WORKER_API_URL=
AUDIO_WORKER_API_KEY=
AIS_AUDIO_WORKER_MODE=disabled
AIS_FFMPEG_PATH=
AIS_FFPROBE_PATH=
AIS_AUDIO_BINARY_MODE=system

# Local Producer Mode paths
AIS_LOCAL_LIBRARY_DIR=
AIS_LOCAL_DROPZONE_DIR=
AIS_LOCAL_CACHE_DIR=

# Future storage provider configuration
STORAGE_PROVIDER=supabase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
